# 统一换行符：仓库内一律存 LF，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.zip  binary
*.7z   binary
*.gz   binary
*.exe  binary
*.ttf  binary

# Windows 脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
